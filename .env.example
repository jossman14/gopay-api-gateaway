PORT=3000
AUTO_PORT=true
MAX_PORT_ATTEMPTS=20
API_KEY=YOUR_API_KEY_HERE
QRIS_STATIC=YOUR_QRIS_STATIC_HERE
GOPAY_MERCHANT_ID=YOUR_MERCHANT_ID_HERE # Opsional: Kosongkan jika tidak tahu (akan menggunakan default fallback)

# Dashboard admin. Ganti password sebelum server dibuka ke internet.
ADMIN_EMAIL=admin@hehe.com
ADMIN_PASSWORD=admin@hehe.com
ADMIN_SECURE_COOKIE=false

# Invoice API v1
PAYMENT_EXPIRY_MINUTES=15
USE_UNIQUE_AMOUNT=true
UNIQUE_AMOUNT_MIN=1
UNIQUE_AMOUNT_MAX=999
RECONCILE_INTERVAL_SECONDS=20
PAYMENT_STORE_FILE=data/payments.json

# Wajib jika callback_url dipakai. Buat secret acak minimal 32 karakter.
WEBHOOK_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
# Opsional dan direkomendasikan: hostname callback yang diizinkan, dipisahkan koma.
WEBHOOK_ALLOWED_HOSTS=

# Aktifkan sementara hanya saat menguji apakah reference tag 62.05 diteruskan GoPay.
ENABLE_RAW_TRANSACTION_DEBUG=false
