# ── Wajib ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://payments_user:PASSWORD@shared-postgres-ktnl5x:5432/payments_db
PORT=3000

# ── Admin (kosongkan untuk mematikan dashboard, bukan memberi default lemah) ──
ADMIN_SESSION_SECRET=

# ── Invoice ──────────────────────────────────────────────────────────────────
PAYMENT_EXPIRY_MINUTES=15
# Nominal unik HANYA dibutuhkan provider gopay hasil rekayasa balik.
# Provider gobiz dan mayar memakai order_id resmi, jadi tidak perlu.
USE_UNIQUE_AMOUNT=true
UNIQUE_AMOUNT_MIN=1
UNIQUE_AMOUNT_MAX=999

# ── Webhook keluar ───────────────────────────────────────────────────────────
# Batasi hostname callback; tanpa ini gateway bisa dipakai sebagai batu
# loncatan SSRF oleh klien yang dikompromikan.
WEBHOOK_ALLOWED_HOSTS=nusawangsa.com
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=10000

# ── Provider: GoBiz Open API (RESMI — utamakan ini) ──────────────────────────
# Daftar di https://developer.gobiz.com untuk memperoleh kredensial.
GOBIZ_ENABLED=false
GOBIZ_CLIENT_ID=
GOBIZ_CLIENT_SECRET=
GOBIZ_OUTLET_ID=
GOBIZ_SANDBOX=true

# ── Provider: Mayar ──────────────────────────────────────────────────────────
MAYAR_ENABLED=false
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
MAYAR_SANDBOX=false

# ── Provider: GoPay (rekayasa balik — cadangan, rapuh) ───────────────────────
# Jalan tanpa registrasi, tapi bergantung pada API internal GoJek dan hanya
# bisa mengetahui pelunasan lewat polling. Pindah ke GOBIZ begitu bisa.
GOPAY_ENABLED=false
# UUID TETAP per instalasi. Berubah-ubah membuat GoID memaksa OTP ulang.
GOPAY_DEVICE_ID=
QRIS_STATIC=
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_SECONDS=20
