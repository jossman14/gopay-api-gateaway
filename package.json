{
  "name": "payments-master-gateway",
  "version": "2.0.0",
  "description": "Gateway pembayaran master: QRIS GoBiz + Mayar, ledger multi-aplikasi di PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node -e \"const{load}=require('./src/config');const{getPool,closePool}=require('./src/db/pool');const{migrate}=require('./src/db/migrate');(async()=>{const p=getPool(load().databaseUrl);await migrate(p);await closePool();})()\"",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
